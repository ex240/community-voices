# Copy this file to .env and fill in values locally.
# Do not commit .env. The app starts without an API key.

OPENAI_API_KEY=
GENERATION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./data/chroma
LOOKBACK_DAYS=7
MAX_THREADS=50
MAX_COMMENTS_PER_THREAD=12
HTTP_TIMEOUT_SECONDS=15
MAX_HTTP_REQUESTS=80
MAX_INGEST_SECONDS=120
MAX_CHUNK_CHARS=1200
REPORT_PATH=./data/latest_report.json
THEME_COUNT=6
THEME_OVERVIEW_THREADS=40
THEME_SNIPPET_CHARS=180
RETRIEVAL_PER_THEME=8
EVIDENCE_PER_THREAD=2
GENERATION_TEMPERATURE=0.2
GENERATION_TIMEOUT_SECONDS=60
BASELINE_REPORT_PATH=./data/latest_baseline_report.json
COMPARISON_PATH=./data/latest_comparison.json
